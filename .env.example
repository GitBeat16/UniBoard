# Supabase project: uniboard (org: attest, region: ap-south-1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional. Only needed to read timetables out of photos and PDFs.
# Calendar links and .ics files work without it.
GROQ_API_KEY=

# The stable production address, e.g. https://uniboard.vercel.app
# Used for links that outlive a request (the calendar feed). Optional on
# Vercel, which provides VERCEL_PROJECT_PRODUCTION_URL; leave empty locally.
NEXT_PUBLIC_SITE_URL=
